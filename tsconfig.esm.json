{
  // Build ESM. `nodenext` produirait du CJS (package racine CommonJS), on force
  // donc une sortie ES modules. Les imports relatifs des sources portent déjà
  // l'extension `.js`, la sortie est donc valide en ESM natif Node.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "esnext",
    "moduleResolution": "bundler",
    "outDir": "dist/esm",
    "noEmit": false,
    // Les sources publiées n'utilisent aucun type de test.
    "types": [],
    "declaration": false,
    "sourceMap": true,
    // `src/` n'est pas publié : sans les sources embarquées, les maps
    // pointeraient vers des fichiers absents du paquet.
    "inlineSources": true
  },
  "include": ["src/**/*.ts"]
}
